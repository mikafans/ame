{
  "name": "ame-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "type-check": "tsc --noEmit",
    "api:gen": "openapi-typescript ../api/openapi.yaml -o src/api/generated/schema.d.ts",
    "api:check": "bun run api:gen && git diff --exit-code src/api/generated/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "15.0.3",
    "openapi-fetch": "0.17.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "22.10.1",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.16.0",
    "eslint-config-next": "15.0.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.4.49",
    "prettier": "3.4.1",
    "tailwindcss": "3.4.15",
    "typescript": "5.7.2"
  }
}
