# syntax=docker/dockerfile:1.7

FROM rust:1.95-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY api/Cargo.toml api/Cargo.lock api/
RUN mkdir -p api/src api/src/bin api/benches \
  && printf 'fn main() {}\n' > api/src/main.rs \
  && printf '' > api/src/lib.rs \
  && printf 'fn main() {}\n' > api/src/bin/gen_openapi.rs \
  && printf 'fn main() {}\n' > api/benches/hot_paths.rs \
  && cargo build --manifest-path api/Cargo.toml --bin ame-api \
  && rm -rf api/src

COPY api/src api/src
COPY api/llms.txt api/llms.txt
COPY db/migrations db/migrations
COPY ame.dev.toml ame.dev.toml

# The first build only warms dependency artifacts with a dummy binary.
RUN touch api/src/main.rs api/src/lib.rs \
  && cargo build --manifest-path api/Cargo.toml --bin ame-api

ENV AME_CONFIG_PATH=/workspace/ame.dev.toml
ENV AME_PORT=8080
ENV RUST_LOG=ame_api=debug,tower_http=info,sqlx=warn

EXPOSE 8080
CMD ["cargo", "run", "--manifest-path", "api/Cargo.toml", "--bin", "ame-api"]
