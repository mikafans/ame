# syntax=docker/dockerfile:1.7

FROM rust:1.95-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY Cargo.toml Cargo.lock ./
COPY api api
COPY crates crates
COPY docs/public docs/public
COPY sdk/python sdk/python
COPY db/migrations db/migrations
COPY ame.dev.toml ame.dev.toml

RUN cargo build --jobs 1 --manifest-path api/Cargo.toml --bin ame-api

ENV AME_CONFIG_PATH=/workspace/ame.dev.toml
ENV AME_PORT=8080
ENV RUST_LOG=ame_api=debug,tower_http=info,sqlx=warn

EXPOSE 8080
CMD ["cargo", "run", "--manifest-path", "api/Cargo.toml", "--bin", "ame-api"]
