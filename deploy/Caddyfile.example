# Run Caddy on the host and point it at the loopback ports published by
# docker-compose.prod.yml. Replace the hostname with your public DNS name.
ame.example.com {
    # One public boundary: API routes, machine contracts, and the downloadable
    # SDK are all API-backed and share the same strict public limiter.
    handle /api/* {
        reverse_proxy 127.0.0.1:8080
    }
    handle /public/* {
        reverse_proxy 127.0.0.1:8080
    }
    handle /healthz {
        reverse_proxy 127.0.0.1:8080
    }
    handle /readyz {
        reverse_proxy 127.0.0.1:8080
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
