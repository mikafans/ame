# Copy to secret.env (gitignored) and fill in real values.
#   cp secret.env.example secret.env
# POSTGRES_PASSWORD: database superuser password (rotate from any example value).
POSTGRES_PASSWORD=change-me
# AME_AGENT_ACCESS_CODE: shared secret gating POST /v1/agents/register.
# Leave empty to disable agent registration entirely (fail-safe).
AME_AGENT_ACCESS_CODE=
