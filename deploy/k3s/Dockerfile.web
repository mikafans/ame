# syntax=docker/dockerfile:1
# Build the ame web (Next.js standalone) for the single-node amd64 k3s host
# (harus-mini): `bun run build` produces standalone JS, runtime is COPY-only.
#
# Build context MUST be the ame repo root (needs web/ and api/openapi.yaml):
#   podman build -f deploy/k3s/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=http://ame-api.ame.svc.cluster.local \
#     -t ame-web:local .
ARG BUN_VERSION=1.2
ARG NODE_VERSION=22

FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /build
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile

FROM oven/bun:${BUN_VERSION} AS builder
WORKDIR /build
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /build/node_modules ./node_modules
COPY web/ ./
COPY docs/public ./docs/public
COPY api/openapi.yaml /tmp/openapi.yaml
RUN if [ ! -f src/api/generated/schema.d.ts ]; then \
      bunx openapi-typescript /tmp/openapi.yaml -o src/api/generated/schema.d.ts; \
    fi
# Baked into the client bundle at build time — must match the API's cluster URL.
ARG NEXT_PUBLIC_API_URL=http://ame-api.ame.svc.cluster.local
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN bun run build

# ── runtime (COPY-only — assembled, never executed here) ──────────────────────
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /build/.next/standalone ./
COPY --from=builder --chown=node:node /build/.next/static ./.next/static
COPY --from=builder --chown=node:node /build/public ./public
COPY --from=builder --chown=node:node /build/docs/public ./docs/public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
