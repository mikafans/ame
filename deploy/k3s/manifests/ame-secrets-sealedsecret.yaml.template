# TEMPLATE — shows how to (re)create the ame-secrets SealedSecret.
# The real, sealed file (ame-secrets-sealedsecret.yaml) is safe to commit:
# its values are encrypted to THIS cluster's controller key only.
#
# Keys:
#   POSTGRES_PASSWORD     — superuser password for the bundled ame-postgres.
#   AME_AGENT_ACCESS_CODE — shared secret gating POST /v1/agents/register.
#                           Leave EMPTY to disable agent registration (fail-safe).
#   ADMIN_PASSWORD        — root admin's login password, consumed once by the
#                           ame-bootstrap-admin Job (bootstrap-admin.yaml). The
#                           Job argon2-hashes it; the plaintext lives only here,
#                           encrypted to this cluster's controller key.
#
# Recreate (run on harus-mini, controller = sealed-secrets-controller/kube-system).
# fish shell:
#
#   set PG (openssl rand -hex 24)
#   kubectl create secret generic ame-secrets \
#     --namespace harus-edge \
#     --from-literal=POSTGRES_PASSWORD="$PG" \
#     --from-literal=AME_AGENT_ACCESS_CODE="" \
#     --from-literal=ADMIN_PASSWORD="$ADMIN_PW" \
#     --dry-run=client -o yaml \
#   | kubeseal --controller-namespace kube-system --format yaml > ame-secrets-sealedsecret.yaml
#
# (set ADMIN_PW out-of-band — e.g. `read -s ADMIN_PW` — so it never lands in a
#  committed file or fish history.)
#
# If you rotate POSTGRES_PASSWORD after the DB volume already exists, you must
# also ALTER USER postgres inside ame-postgres — the password is only read at
# first init (empty PGDATA).

apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: ame-secrets
  namespace: harus-edge
spec:
  encryptedData:
    POSTGRES_PASSWORD: AgB...replace...
    AME_AGENT_ACCESS_CODE: AgB...replace...
    ADMIN_PASSWORD: AgB...replace...
  template:
    metadata:
      name: ame-secrets
      namespace: harus-edge
    type: Opaque
