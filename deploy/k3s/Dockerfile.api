# syntax=docker/dockerfile:1
# Build the ame API for the single-node amd64 k3s host (harus-mini):
#   - rust:alpine's toolchain is musl-native, so a plain `cargo build --release`
#     already produces a static x86_64-unknown-linux-musl binary — no
#     cross-compile tooling needed.
#   - runtime is a COPY-only distroless image.
# AME has no OpenSSL dep (sqlx no-TLS, reqwest rustls-tls), so a fully static
# musl binary links cleanly. Migrations and public machine-facing documents
# are embedded in the binary at build time.
#
# Build context MUST be the ame repo root:
#   podman build -f deploy/k3s/Dockerfile.api -t ame-api:local .
ARG RUST_VERSION=1.97.1

FROM rust:${RUST_VERSION}-alpine AS builder
RUN apk add --no-cache musl-dev
WORKDIR /build

# Workspace manifest + lock (api depends on path crates under crates/, so the
# workspace root, not just api/, must resolve).
COPY Cargo.toml Cargo.lock ./
COPY api/Cargo.toml ./api/
COPY api/src ./api/src
COPY crates ./crates
# sqlx::migrate! embeds these (resolved as ../db/migrations from the crate).
COPY db/migrations ./db/migrations
# Public agent documents are compile-time assets for the API handlers.
COPY docs/public ./docs/public

RUN cargo build --release -p ame-api --bin ame-api \
  && cp target/release/ame-api /build/ame-api

# ── runtime (COPY-only — assembled, never executed here) ──────────────────────
FROM gcr.io/distroless/static-debian12:nonroot AS runtime
COPY --from=builder /build/ame-api /usr/local/bin/ame-api
EXPOSE 8080
ENV RUST_LOG=ame_api=info,tower_http=info,sqlx=warn
ENTRYPOINT ["/usr/local/bin/ame-api"]
