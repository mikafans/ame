# Copy to .env (gitignored) and adjust as needed. The defaults below match `make dev`.

# ── API ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ame
RUST_LOG=ame_api=debug,tower_http=info,sqlx=warn

# Comma-separated list of allowed CORS origins. Default: http://localhost:3000.
# Use "*" to allow any origin (only when the API is intentionally public).
# AME_CORS_ORIGINS=http://localhost:3000,https://app.example.com

# Shared secret for /v1/agents/register. Registration is disabled if unset.
# Generate with `openssl rand -hex 32`.
# AME_AGENT_ACCESS_CODE=

# Rate limit for the public auth + agent-registration endpoints (per IP).
# Defaults: burst 10, refill 1 every 2 s (~30 req/min sustained).
# AME_RATELIMIT_BURST=10
# AME_RATELIMIT_PERIOD_SECS=2

# Opt into DB-backed integration tests (`make test-db`).
# AME_RUN_DB_TESTS=1

# ── Frontend (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# Comma-separated extra origins Next dev allows (used by `make dev API_HOST=...`).
# NEXT_ALLOWED_ORIGINS=harus-mini

# ── Makefile overrides ─────────────────────────────────────────────────────
# Point the frontend at a remote API host (e.g. when dev'ing over Tailscale).
# API_HOST=harus-mini

# ── Prod compose (docker-compose.prod.yml / make docker-*) ───────────────────
# Required — the stack refuses to start without it.
POSTGRES_PASSWORD=change-me
# Production overrides: set these to the public HTTPS origin before building.
# AME_CORS_ORIGINS=https://ame.example.com
# NEXT_PUBLIC_API_URL=https://ame.example.com
# AME_PRODUCTION=1
# POSTGRES_USER=postgres
# POSTGRES_DB=ame
# Host ports the stack publishes (api and web listen on 8080 / 3000 in-container).
# API_PORT=8080
# WEB_PORT=3000
