{$AME_HOSTNAME} {
    handle /api/* {
        reverse_proxy api:8080
    }

    # One public boundary: API routes, machine contracts, and the downloadable
    # SDK are all served by the API and share the same strict public limiter.
    handle /public/* {
        reverse_proxy api:8080
    }

    handle /healthz {
        reverse_proxy api:8080
    }

    handle /readyz {
        reverse_proxy api:8080
    }

    handle /metrics {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy web:3000
    }
}
