{
  "auth": {
    "format": "ame_token",
    "registration": "POST /public/v1/auth/register followed by POST /public/v1/onboarding/start returns a learner bearer token; no separate integration identity is required.",
    "type": "bearer"
  },
  "description": "ame — study, sweetened. An agent-friendly learning API with one owner-scoped learner model.",
  "entrypoint": "/public/llms.txt",
  "name": "ame",
  "principles": [
    "Agents and people use the same authenticated learner API.",
    "Every learning resource is scoped to the bearer token's learner.",
    "The API never sends email; email is an account identifier in self-host mode.",
    "Use idempotencyKey when starting a journey."
  ],
  "schema_version": "v1",
  "tools": [
    {
      "description": "Preview the promise, objectives, and first activity for a learner's prompt without creating state.",
      "input_schema": {
        "properties": {
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.preview",
      "path": "/public/v1/onboarding/preview"
    },
    {
      "description": "Create or resume a learner account and bootstrap the first owner-scoped journey from one prompt.",
      "input_schema": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "displayName",
          "prompt",
          "idempotencyKey"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.start",
      "path": "/public/v1/onboarding/start"
    },
    {
      "description": "List the authenticated learner's journeys and the next activity for each.",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "method": "GET",
      "name": "learning.journey.list",
      "path": "/api/v1/learning/journeys"
    },
    {
      "description": "Read one authenticated learner's intent, objectives, activities, and evidence.",
      "input_schema": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.journey.get",
      "path": "/api/v1/learning/journeys/{id}"
    },
    {
      "description": "Start an activity in an owned journey.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "journeyId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "journeyId",
          "activityId"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.activity.start",
      "path": "/api/v1/learning/journeys/{journey_id}/activities/{activity_id}/start"
    },
    {
      "description": "Finish a learning session and persist the learner's evidence and responses.",
      "input_schema": {
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "responses": {
            "type": "array"
          }
        },
        "required": [
          "id",
          "completed",
          "responses"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.session.finish",
      "path": "/api/v1/learning/sessions/{id}/finish"
    },
    {
      "description": "Create a learner-owned versioned question with explanation and provenance metadata.",
      "input_schema": {
        "properties": {
          "acceptedAnswers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "difficulty": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "multiple_choice",
              "true_false",
              "short_answer",
              "essay",
              "code"
            ],
            "type": "string"
          },
          "options": {
            "type": "array"
          },
          "points": {
            "minimum": 1,
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "reviewStatus": {
            "type": "string"
          },
          "sourceReferences": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "kind",
          "prompt",
          "points"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.question.create",
      "path": "/api/v1/questions"
    },
    {
      "description": "Read one exact learner-owned question version for reproducible assessment history.",
      "input_schema": {
        "properties": {
          "questionId": {
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "questionId",
          "version"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.question.get",
      "path": "/api/v1/questions/{question_id}/versions/{version}"
    },
    {
      "description": "Create the next immutable version of a learner-owned question.",
      "input_schema": {
        "properties": {
          "difficulty": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "points": {
            "minimum": 1,
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "prompt",
          "points"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.question.revise",
      "path": "/api/v1/questions/{question_id}/versions"
    },
    {
      "description": "Compose approved question versions into a learner-owned practice or graded assessment.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "items": {
            "items": {
              "properties": {
                "objectiveId": {
                  "format": "uuid",
                  "type": "string"
                },
                "orderIndex": {
                  "type": "integer"
                },
                "points": {
                  "minimum": 1,
                  "type": "integer"
                },
                "questionId": {
                  "format": "uuid",
                  "type": "string"
                },
                "questionVersion": {
                  "type": "integer"
                }
              },
              "required": [
                "objectiveId",
                "questionId",
                "questionVersion",
                "orderIndex",
                "points"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "mode": {
            "enum": [
              "practice",
              "graded"
            ],
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "activityId",
          "mode",
          "items"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.assessment.create",
      "path": "/api/v1/assessments"
    },
    {
      "description": "Read one learner-owned assessment and its exact question-version membership.",
      "input_schema": {
        "properties": {
          "assessmentId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "assessmentId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.assessment.get",
      "path": "/api/v1/assessments/{assessment_id}"
    },
    {
      "description": "Discover the learner-owned assessment attached to an activity before starting it.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "activityId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.assessment.get_for_activity",
      "path": "/api/v1/assessments?activityId={activity_id}"
    },
    {
      "description": "Start or resume an attempt against one immutable assessment version.",
      "input_schema": {
        "properties": {
          "assessmentId": {
            "format": "uuid",
            "type": "string"
          },
          "learningSessionId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "assessmentId",
          "learningSessionId"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.attempt.start",
      "path": "/api/v1/assessments/{assessment_id}/attempts"
    },
    {
      "description": "Save one answer while preserving assessment item and question version identity.",
      "input_schema": {
        "properties": {
          "assessmentItemId": {
            "format": "uuid",
            "type": "string"
          },
          "attemptId": {
            "format": "uuid",
            "type": "string"
          },
          "questionVersionId": {
            "format": "uuid",
            "type": "string"
          },
          "response": {
            "type": "object"
          }
        },
        "required": [
          "attemptId",
          "assessmentItemId",
          "questionVersionId",
          "response"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.attempt.answer",
      "path": "/api/v1/attempts/{attempt_id}/answers"
    },
    {
      "description": "Finish an attempt, grade deterministic items, and return manual-review state when needed.",
      "input_schema": {
        "properties": {
          "attemptId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "attemptId"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.attempt.finish",
      "path": "/api/v1/attempts/{attempt_id}/finish"
    },
    {
      "description": "Read an owned attempt and its saved responses/result.",
      "input_schema": {
        "properties": {
          "attemptId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "attemptId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.attempt.get",
      "path": "/api/v1/attempts/{attempt_id}"
    },
    {
      "description": "Read all assessment attempts in one learner-owned journey, including durable results.",
      "input_schema": {
        "properties": {
          "journeyId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "journeyId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.attempt.history",
      "path": "/api/v1/learning/journeys/{journey_id}/attempts"
    },
    {
      "description": "Record rebuildable mastery evidence from a completed learner attempt.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "attemptId": {
            "format": "uuid",
            "type": "string"
          },
          "derivationVersion": {
            "minimum": 1,
            "type": "integer"
          },
          "journeyId": {
            "format": "uuid",
            "type": "string"
          },
          "objectiveId": {
            "format": "uuid",
            "type": "string"
          },
          "value": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "journeyId",
          "objectiveId",
          "activityId",
          "attemptId",
          "value",
          "derivationVersion"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.progress.evidence",
      "path": "/api/v1/progress/evidence"
    },
    {
      "description": "Read evidence-derived mastery and confidence for one objective.",
      "input_schema": {
        "properties": {
          "journeyId": {
            "format": "uuid",
            "type": "string"
          },
          "objectiveId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "journeyId",
          "objectiveId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.progress.snapshot",
      "path": "/api/v1/progress/{journey_id}/objectives/{objective_id}"
    },
    {
      "description": "Select the weakest objective from an explicit journey objective set.",
      "input_schema": {
        "properties": {
          "journeyId": {
            "format": "uuid",
            "type": "string"
          },
          "objectives": {
            "type": "array"
          }
        },
        "required": [
          "journeyId",
          "objectives"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.progress.recommend",
      "path": "/api/v1/progress/{journey_id}/recommendation"
    },
    {
      "description": "Record an idempotent qualifying learning day from a completed attempt event (attempt:<id>); the day must match the attempt's graded timestamp in the supplied IANA learner timezone.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "journeyId": {
            "format": "uuid",
            "type": "string"
          },
          "learnerTimezone": {
            "type": "string"
          },
          "qualifyingDay": {
            "format": "date",
            "type": "string"
          },
          "qualifyingEventKey": {
            "type": "string"
          }
        },
        "required": [
          "journeyId",
          "activityId",
          "qualifyingEventKey",
          "learnerTimezone",
          "qualifyingDay"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.progress.streak.record",
      "path": "/api/v1/progress/streaks"
    },
    {
      "description": "Read qualifying learning days for one owned journey.",
      "input_schema": {
        "properties": {
          "journeyId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "journeyId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.progress.streak.list",
      "path": "/api/v1/progress/{journey_id}/streaks"
    },
    {
      "description": "Read the ordered activity, assessment, evidence, deep-dive, and streak history for one owned journey.",
      "input_schema": {
        "properties": {
          "journeyId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "journeyId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.progress.timeline",
      "path": "/api/v1/progress/{journey_id}/timeline"
    },
    {
      "description": "Create a source-backed explanatory deep dive linked to existing evidence owned by the learner and matching the same journey, objective, and activity.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "applicationTask": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "example": {
            "type": "string"
          },
          "journeyId": {
            "format": "uuid",
            "type": "string"
          },
          "objectiveId": {
            "format": "uuid",
            "type": "string"
          },
          "sourceReferences": {
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "triggeringEvidenceId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "journeyId",
          "activityId",
          "objectiveId",
          "triggeringEvidenceId",
          "title",
          "body",
          "example",
          "sourceReferences",
          "applicationTask"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.deep_dive.create",
      "path": "/api/v1/deep-dives"
    },
    {
      "description": "Discover the source-backed deep dive attached to an activity.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "activityId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.deep_dive.get_for_activity",
      "path": "/api/v1/deep-dives?activityId={activity_id}"
    },
    {
      "description": "Read one source-backed deep dive owned by the learner.",
      "input_schema": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.deep_dive.get",
      "path": "/api/v1/deep-dives/{id}"
    },
    {
      "description": "Start or resume an owner-scoped provider generation run with an idempotent retry key.",
      "input_schema": {
        "properties": {
          "contentVersion": {
            "minimum": 1,
            "type": "integer"
          },
          "operation": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "retryKey": {
            "type": "string"
          }
        },
        "required": [
          "operation"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.generation.start",
      "path": "/api/v1/generation-runs"
    },
    {
      "description": "Read the status, provider, failure detail, and content version of an owned generation run.",
      "input_schema": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.generation.get",
      "path": "/api/v1/generation-runs/{id}"
    },
    {
      "description": "Advance an owned generation run or record a provider failure; failed runs cannot be published.",
      "input_schema": {
        "properties": {
          "error": {
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "requested",
              "running",
              "review_required",
              "published",
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "type": "object"
      },
      "method": "PATCH",
      "name": "learning.generation.transition",
      "path": "/api/v1/generation-runs/{id}"
    }
  ]
}
