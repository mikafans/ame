{
  "auth": {
    "format": "ame_token",
    "registration": "POST /v1/onboarding/start returns a learner bearer token; no separate integration identity is required.",
    "type": "bearer"
  },
  "description": "ame — study, sweetened. An agent-friendly learning API with one owner-scoped learner model.",
  "entrypoint": "/llms.txt",
  "name": "ame",
  "principles": [
    "Agents and people use the same authenticated learner API.",
    "Every learning resource is scoped to the bearer token's learner.",
    "The API never sends email; email is an account identifier in self-host mode.",
    "Use idempotencyKey when starting a journey."
  ],
  "schema_version": "v1",
  "tools": [
    {
      "description": "Preview the promise, objectives, and first activity for a learner's prompt without creating state.",
      "input_schema": {
        "properties": {
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.preview",
      "path": "/v1/onboarding/preview"
    },
    {
      "description": "Create or resume a learner account and bootstrap the first owner-scoped journey from one prompt.",
      "input_schema": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "displayName",
          "prompt",
          "idempotencyKey"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.start",
      "path": "/v1/onboarding/start"
    },
    {
      "description": "List the authenticated learner's journeys and the next activity for each.",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "method": "GET",
      "name": "learning.journey.list",
      "path": "/v1/learning/journeys"
    },
    {
      "description": "Read one authenticated learner's intent, objectives, activities, and evidence.",
      "input_schema": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.journey.get",
      "path": "/v1/learning/journeys/{id}"
    },
    {
      "description": "Start an activity in an owned journey.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "journeyId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "journeyId",
          "activityId"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.activity.start",
      "path": "/v1/learning/journeys/{journey_id}/activities/{activity_id}/start"
    },
    {
      "description": "Finish a learning session and persist the learner's evidence and responses.",
      "input_schema": {
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "responses": {
            "type": "array"
          }
        },
        "required": [
          "id",
          "completed",
          "responses"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.session.finish",
      "path": "/v1/learning/sessions/{id}/finish"
    },
    {
      "description": "Create a learner-owned versioned question with explanation and provenance metadata.",
      "input_schema": {
        "properties": {
          "acceptedAnswers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "explanation": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "multiple_choice",
              "true_false",
              "short_answer",
              "essay",
              "code"
            ],
            "type": "string"
          },
          "options": {
            "type": "array"
          },
          "points": {
            "minimum": 1,
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "reviewStatus": {
            "type": "string"
          },
          "sourceReferences": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "kind",
          "prompt",
          "points"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.question.create",
      "path": "/v1/questions"
    },
    {
      "description": "Read one exact learner-owned question version for reproducible assessment history.",
      "input_schema": {
        "properties": {
          "questionId": {
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "questionId",
          "version"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.question.get",
      "path": "/v1/questions/{question_id}/versions/{version}"
    },
    {
      "description": "Create the next immutable version of a learner-owned question.",
      "input_schema": {
        "properties": {
          "kind": {
            "type": "string"
          },
          "points": {
            "minimum": 1,
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "prompt",
          "points"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.question.revise",
      "path": "/v1/questions/{question_id}/versions"
    }
  ]
}
