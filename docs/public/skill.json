{
  "auth": {
    "format": "ame_token",
    "registration": "POST /public/v1/auth/register followed by POST /public/v1/onboarding/start returns a learner bearer token; no separate integration identity is required.",
    "type": "bearer"
  },
  "description": "ame — study, sweetened. An agent-friendly learning API with one owner-scoped learner model.",
  "entrypoint": "/public/llms.txt",
  "name": "ame",
  "principles": [
    "Agents and people use the same authenticated learner API.",
    "Every learning resource is scoped to the bearer token's learner.",
    "The API never sends email; email is an account identifier in self-host mode.",
    "Use idempotencyKey when starting a journey."
  ],
  "schema_version": "v1",
  "tools": [
    {
      "description": "Register a learner account and receive the bearer session used by the unified learning API. Self-host mode does not send email.",
      "input_schema": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "identity.register",
      "path": "/public/v1/auth/register"
    },
    {
      "description": "Authenticate an existing learner account and receive the bearer session used by the unified learning API.",
      "input_schema": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "identity.login",
      "path": "/public/v1/auth/login"
    },
    {
      "description": "Preview the promise, objectives, and first activity for a learner's prompt without creating state.",
      "input_schema": {
        "properties": {
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.preview",
      "path": "/public/v1/onboarding/preview"
    },
    {
      "description": "Create or resume a learner account and bootstrap the first owner-scoped journey from one prompt.",
      "input_schema": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "displayName",
          "prompt",
          "idempotencyKey"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.start",
      "path": "/public/v1/onboarding/start"
    },
    {
      "description": "List the authenticated learner's journeys and the next activity for each.",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "method": "GET",
      "name": "learning.journey.list",
      "path": "/api/v1/learning/journeys"
    },
    {
      "description": "Read one authenticated learner's intent, objectives, activities, evidence, and the same evidence-backed recommendation returned to the browser. The recommendation includes objectiveId and server-derived evidenceIds.",
      "input_schema": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.journey.get",
      "path": "/api/v1/learning/journeys/{id}"
    },
    {
      "description": "Start an activity in an owned journey.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "journeyId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "journeyId",
          "activityId"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.activity.start",
      "path": "/api/v1/learning/journeys/{journey_id}/activities/{activity_id}/start"
    },
    {
      "description": "Import bounded learner-owned source text as an immutable SHA-256 snapshot. URL imports accept public HTTPS only; document and local-file imports accept agent-supplied text and never read server filesystem paths.",
      "input_schema": {
        "properties": {
          "content": {
            "description": "Required for document and local_file; ignored for URL.",
            "type": "string"
          },
          "kind": {
            "enum": [
              "url",
              "document",
              "local_file"
            ],
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "mediaType": {
            "enum": [
              "text/plain",
              "text/markdown",
              "text/html",
              "application/json"
            ],
            "type": "string"
          },
          "retryKey": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "locator",
          "retryKey"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.source.import",
      "path": "/api/v1/sources/imports"
    },
    {
      "description": "Inspect completed and failed source import runs for the authenticated learner, including stable failure codes.",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "method": "GET",
      "name": "learning.source.import.list",
      "path": "/api/v1/source-imports"
    },
    {
      "description": "List the authenticated learner's immutable source snapshots.",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "method": "GET",
      "name": "learning.source.snapshot.list",
      "path": "/api/v1/source-snapshots"
    },
    {
      "description": "Read one authenticated learner's immutable source snapshot and digest.",
      "input_schema": {
        "properties": {
          "snapshotId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "snapshotId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.source.snapshot.get",
      "path": "/api/v1/source-snapshots/{snapshot_id}"
    },
    {
      "description": "Certify an exact byte range in an immutable source snapshot with grounding and licensing review metadata.",
      "input_schema": {
        "properties": {
          "endByte": {
            "minimum": 1,
            "type": "integer"
          },
          "extractionMethod": {
            "enum": [
              "exact_quote",
              "manual_selection"
            ],
            "type": "string"
          },
          "groundingNote": {
            "type": "string"
          },
          "groundingStatus": {
            "enum": [
              "supported",
              "contradicted",
              "unverified"
            ],
            "type": "string"
          },
          "licenseName": {
            "type": "string"
          },
          "licenseStatus": {
            "enum": [
              "allowed",
              "restricted",
              "unknown"
            ],
            "type": "string"
          },
          "licenseUrl": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "snapshotId": {
            "format": "uuid",
            "type": "string"
          },
          "startByte": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "snapshotId",
          "startByte",
          "endByte",
          "quote",
          "extractionMethod",
          "groundingStatus",
          "groundingNote",
          "licenseStatus"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.citation.create",
      "path": "/api/v1/citations"
    },
    {
      "description": "Inspect learner-owned citation certificates and their immutable snapshot anchors.",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "method": "GET",
      "name": "learning.citation.list",
      "path": "/api/v1/citations"
    },
    {
      "description": "Read one learner-owned citation certificate, grounding decision, and licensing metadata.",
      "input_schema": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.citation.get",
      "path": "/api/v1/citations/{id}"
    },
    {
      "description": "Finish a learning session and persist the learner's evidence and responses.",
      "input_schema": {
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "responses": {
            "type": "array"
          }
        },
        "required": [
          "id",
          "completed",
          "responses"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.session.finish",
      "path": "/api/v1/learning/sessions/{id}/finish"
    },
    {
      "description": "Read one authenticated learner's activity session so an external agent can resume the same state as the browser.",
      "input_schema": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.session.get",
      "path": "/api/v1/learning/sessions/{id}"
    },
    {
      "description": "Start a submission for an application task at its immutable content version. The response is not evidence until evaluation reaches a reviewed state.",
      "input_schema": {
        "properties": {
          "contentVersion": {
            "minimum": 1,
            "type": "integer"
          },
          "evaluationMethod": {
            "enum": [
              "self_review",
              "automatic",
              "agent",
              "manual"
            ],
            "type": "string"
          },
          "response": {
            "type": "object"
          },
          "taskId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "contentVersion",
          "response"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.task.submission.start",
      "path": "/api/v1/tasks/{task_id}/submissions"
    },
    {
      "description": "Submit an application-task response for evaluation. It may become pending review rather than immediately producing a score.",
      "input_schema": {
        "properties": {
          "submissionId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "submissionId"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.task.submission.submit",
      "path": "/api/v1/task-submissions/{submission_id}/submit"
    },
    {
      "description": "Read the learner's task submission status, score, and reviewer or agent feedback.",
      "input_schema": {
        "properties": {
          "submissionId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "submissionId"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.task.submission.get",
      "path": "/api/v1/task-submissions/{submission_id}"
    },
    {
      "description": "Replace an uncompleted explanation or worked example with reviewed, source-backed content from a published learning.activity.content.compose generation run.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "content": {
            "description": "The content type must match the activity kind: explanation uses heading, body, key_points; worked_example uses heading, prompt, steps, reflection. Text and list items must be non-empty strings.",
            "required": [
              "type"
            ],
            "type": "object"
          },
          "generationRunId": {
            "format": "uuid",
            "type": "string"
          },
          "reviewStatus": {
            "description": "Only approved content is learner-visible.",
            "enum": [
              "approved"
            ],
            "type": "string"
          },
          "sourceReferences": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "activityId",
          "generationRunId",
          "content",
          "sourceReferences",
          "reviewStatus"
        ],
        "type": "object"
      },
      "method": "PATCH",
      "name": "learning.activity.content.author",
      "path": "/api/v1/learning/activities/{activity_id}/content"
    },
    {
      "description": "Attach a structured scoring rubric to a task/application activity from a published learning.activity.rubric.compose generation run. Criteria and points guide manual/agent review; learners see the criteria. Provenance is mandatory.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "generationRunId": {
            "format": "uuid",
            "type": "string"
          },
          "reviewStatus": {
            "description": "Only approved rubrics are learner-visible.",
            "enum": [
              "approved"
            ],
            "type": "string"
          },
          "rubric": {
            "description": "Structured rubric: version, criteria[] (each id, objectiveId, description, maxPoints>=1, required), optional passingScore 0..1.",
            "properties": {
              "criteria": {
                "items": {
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "maxPoints": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "objectiveId": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "objectiveId",
                    "description",
                    "maxPoints",
                    "required"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "passingScore": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "version": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "version",
              "criteria"
            ],
            "type": "object"
          },
          "sourceReferences": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "activityId",
          "generationRunId",
          "rubric",
          "sourceReferences",
          "reviewStatus"
        ],
        "type": "object"
      },
      "method": "PATCH",
      "name": "learning.activity.rubric.author",
      "path": "/api/v1/learning/activities/{activity_id}/rubric"
    },
    {
      "description": "Create a learner-owned versioned question from a published question.compose generation run; provenance is mandatory.",
      "input_schema": {
        "properties": {
          "acceptedAnswers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "difficulty": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "generationRunId": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "enum": [
              "multiple_choice",
              "true_false",
              "short_answer",
              "numeric",
              "essay",
              "code"
            ],
            "type": "string"
          },
          "options": {
            "type": "array"
          },
          "points": {
            "minimum": 1,
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "reviewStatus": {
            "type": "string"
          },
          "sourceReferences": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "generationRunId",
          "kind",
          "prompt",
          "points"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.question.create",
      "path": "/api/v1/questions"
    },
    {
      "description": "Read one exact learner-owned question version for reproducible assessment history.",
      "input_schema": {
        "properties": {
          "questionId": {
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "questionId",
          "version"
        ],
        "type": "object"
      },
      "method": "GET",
      "name": "learning.question.get",
      "path": "/api/v1/questions/{question_id}/versions/{version}"
    },
    {
      "description": "Create the next immutable question version from a published question.compose generation run.",
      "input_schema": {
        "properties": {
          "difficulty": {
            "type": "string"
          },
          "generationRunId": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "points": {
            "minimum": 1,
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "generationRunId",
          "kind",
          "prompt",
          "points"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.question.revise",
      "path": "/api/v1/questions/{question_id}/versions"
    },
    {
      "description": "Compose approved question versions into a learner-owned practice or graded assessment.",
      "input_schema": {
        "properties": {
          "activityId": {
            "format": "uuid",
            "type": "string"
          },
          "items": {
            "items": {
              "properties": {
                "objectiveId": {
                  "format": "uuid",
                  "type": "string"
                },
                "orderIndex": {
                  "type": "integer"
                },
                "points": {
                  "minimum": 1,
                  "type": "integer"
                },
                "questionId": {
                  "format": "uuid",
                  "type": "string"
                },
                "questionVersion": {
                  "type": "integer"
                }
              },
              "required": [
                "objectiveId",
                "questionId",
                "questionVersion",
                "orderIndex",
                "points"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "mode": {
            "enum": [
              "practice",
              "graded"
            ],
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "activityId",
          "mode",
          "items"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "learning.assessment.create",
      "path": "/api/v1/assessments"
    },
    {
      "description": "Read one learner-owned assessment and its exact question-version membership.",
