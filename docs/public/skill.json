    {
      "description": "Read evidence-derived mastery and confidence for one objective.",
      "input_schema": {
        "properties": {
          "journeyId": {
            "format": "uuid",
            "type": "string"
          },
          "objectiveId": {
            "format": "uuid",
            "type": "string"
